
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F2F2F2">

    <VerticalStackLayout Padding="25"
                         Spacing="20"
                         VerticalOptions="Center"
                         HorizontalOptions="Fill">

        <Label Text="Sobre o Aplicativo"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalOptions="Center" />

        <Frame Padding="25"
               CornerRadius="15"
               BackgroundColor="White">

            <VerticalStackLayout Spacing="18"
                                 HorizontalOptions="Center">

                <Image Source="dotnet_bot.png"
                       HeightRequest="120"
                       Aspect="AspectFit" />

                <Label Text="MauiAppHotel"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center" />

                <Label Text="Aplicativo para cálculo e contratação de hospedagens."
                       FontSize="16"
                       HorizontalTextAlignment="Center" />

                <BoxView HeightRequest="1"
                         Color="LightGray" />

                <Label Text="Desenvolvedor"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label Text="Eduardo do Amaral"
                       FontSize="18"
                       HorizontalOptions="Center" />

                <Label Text="Ano: 2026"
                       FontSize="16"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar"
                Clicked="OnVoltarClicked"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                CornerRadius="10"
                FontAttributes="Bold" />

    </VerticalStackLayout>

</ContentPage>