<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Detalhes da Estadia"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="18"
                             VerticalOptions="Center">

            <!-- Título -->
            <Label Text="Reserva confirmada!"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#17365D"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,5" />

            <Label Text="Confira os detalhes da sua hospedagem"
                   FontSize="14"
                   TextColor="#64748B"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Cartão principal -->
            <Frame Padding="20"
                   CornerRadius="18"
                   BackgroundColor="White"
                   HasShadow="True">

                <VerticalStackLayout Spacing="16">

                    <!-- Acomodação -->
                    <Label Text="ACOMODAÇÃO"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#64748B"
                           HorizontalOptions="Center" />

                    <Label x:Name="lbl_suite"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#17365D"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <BoxView HeightRequest="1"
                             Color="#DCE5EF" />

                    <!-- Hóspedes -->
                    <Label Text="HÓSPEDES"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="#17365D" />

                    <Label x:Name="lbl_adultos"
                           FontSize="16"
                           TextColor="#334155" />

                    <Label x:Name="lbl_criancas"
                           FontSize="16"
                           TextColor="#334155" />

                    <BoxView HeightRequest="1"
                             Color="#DCE5EF" />

                    <!-- Período -->
                    <Label Text="PERÍODO DA HOSPEDAGEM"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="#17365D" />

                    <Label x:Name="lbl_checkin"
                           FontSize="16"
                           TextColor="#334155" />

                    <Label x:Name="lbl_checkout"
                           FontSize="16"
                           TextColor="#334155" />

                    <Label x:Name="lbl_diarias"
                           FontSize="16"
                           TextColor="#334155" />

                    <BoxView HeightRequest="1"
                             Color="#DCE5EF" />

                    <!-- Valor total -->
                    <Label Text="VALOR TOTAL DA HOSPEDAGEM"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="#64748B"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="lbl_valor_total"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#17365D"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>

            <!-- Botão voltar -->
            <Button Text="Voltar"
                    Clicked="OnVoltarClicked"
                    BackgroundColor="#17365D"
                    TextColor="White"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="52" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>